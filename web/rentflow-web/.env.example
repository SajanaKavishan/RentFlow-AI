# Azure backend API base HTTPS URL for production/staging builds (e.g. https://api-staging.rentflow.ai or https://<app-name>.azurewebsites.net)
# Required for deployed builds; if omitted in development, falls back to http://localhost:5277
VITE_API_BASE_URL=

# Optional browser key for Maps JavaScript, Places (New), Maps Embed, and Geocoding.
# Restrict it to approved frontend HTTP referrers and only those Google APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Optional production map ID for the interactive Advanced Marker map.
# If omitted, Google Maps' public DEMO_MAP_ID is used.
VITE_GOOGLE_MAPS_MAP_ID=
