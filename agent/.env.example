AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional existing vision adapter used for document extraction AND maintenance photos.
# These example values may be replaced with any supported vision-capable provider/model.
# Blank/unconfigured or non-vision models fall back to maintenance text analysis.
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
VISION_API_KEY=
AI_TIMEOUT_SECONDS=30
# Maintenance total Python budget = min(AI_TIMEOUT_SECONDS, 30s, backend remaining budget).
# One optional vision call uses <=6s and <=one quarter of that budget.
# Media limits are fixed in code: 5 photos, 1280px side, JPEG quality 80
# (960px/quality 65 fallback), 512 KiB per image, 2 MiB aggregate decoded media.
EXTRACTION_TIMEOUT_SECONDS=20
MAX_PDF_PAGES=5
MAX_EXTRACTED_CHARACTERS=50000
MAX_MODEL_INPUT_CHARACTERS=20000
INCOME_TOLERANCE_PERCENT=5
AGENT_VERSION=0.1.0
AI_DEVELOPMENT_DIAGNOSTICS=false

# Shared with ASP.NET AgentService__ServiceApiKey; required for every /internal/* route.
AGENT_SERVICE_API_KEY=
