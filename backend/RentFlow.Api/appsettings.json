{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=rentflow;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  "AgentService": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 30
  },
  "Payments": {
    "Currency": "LKR"
  },
  "DocumentAnalysis": {
    "Enabled": true,
    "MaxFileBytes": 5242880,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png"
    ]
  },
  "Jwt": {
    "Issuer": "RentFlow.Api",
    "Audience": "RentFlow.Clients",
    "SigningKey": "",
    "ExpiryMinutes": 30
  },
  "StaffProvisioning": {
    "SetupTokenLifetimeMinutes": 60
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 45,
    "DevelopmentWebBaseUrl": "http://localhost:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
